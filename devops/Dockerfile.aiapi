# $BUILDPLATFORM = native platform of the build machine (arm64 locally, amd64 in CI).
# CI workflow pins platforms: linux/amd64, so the pushed image is always amd64 for Render.

FROM --platform=$BUILDPLATFORM python:3.11-slim-bookworm

# By default, listen on port 8000
EXPOSE 8000/tcp

# curl for health checks; libxml2/libxslt and build deps for lxml (readability-lxml)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libxml2-dev libxslt-dev gcc \
    && rm -rf /var/lib/apt/lists/*

# Set the working directory in the container
WORKDIR /app

# Copy the aiapi-specific requirements (no DB, no redis, no scikit-learn/langgraph)
COPY ./aiapi/requirements.txt /app/requirements.txt

# Install any dependencies
# Use --upgrade to ensure all dependencies are resolved to compatible versions
RUN pip install --upgrade pip
RUN pip install --upgrade -r requirements.txt
RUN pip install gunicorn

# Copy the content of the local src directory to the working directory
COPY aiapi aiapi

# Specify the command to run on container start
CMD ["gunicorn"  , "-w", "3", "-b", "0.0.0.0:8000", "aiapi:create_app()","--log-level debug", "--timeout 90"]