# $BUILDPLATFORM = native platform of the build machine (arm64 locally, amd64 in CI).
# CI workflow pins platforms: linux/amd64, so the pushed image is always amd64 for Render.
# slim-bookworm ships prebuilt manylinux wheels for scikit-learn/numpy — much faster than Alpine/musl.

FROM --platform=$BUILDPLATFORM python:3.11-slim-bookworm

# By default, listen on port 8000
EXPOSE 8000/tcp

# curl for health checks; bash/procps for worker_monitor.sh; libxml2/libxslt and build deps for lxml (readability-lxml); libgomp1 for scikit-learn parallelism
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash curl procps libxml2-dev libxslt-dev gcc libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Set the working directory in the container
WORKDIR /app

# Copy the dependencies file to the working directory
COPY ./requirements.txt /app

# Install any dependencies
# Use --upgrade to ensure all dependencies are resolved to compatible versions
RUN pip install --upgrade pip \
    && pip install --upgrade -r requirements.txt \
    && pip install gunicorn

# Copy the content of the local src directory to the working directory
COPY recap recap
COPY aiapi aiapi
COPY ./app.py /app
# migrations - required for flask db upgrade on deploy
COPY ./migrations /app/migrations
# initialize_render_run.sh - render-specific startup script
COPY ./initialize_render_run.sh /app
# worker_monitor.sh - monitors and auto-restarts RQ workers
COPY ./worker_monitor.sh /app

RUN mkdir -p /app/instance
RUN chmod 66 /app/instance 

# Make scripts executable
RUN chmod +x /app/initialize_render_run.sh
RUN chmod +x /app/worker_monitor.sh

CMD ["/bin/sh", "/app/initialize_render_run.sh"]